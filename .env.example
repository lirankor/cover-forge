# cover-forge configuration — copy to .env (never commit .env)

# Optional bearer token. Unset = open (fine when only published on 127.0.0.1).
#TOKEN=change-me

# uid:gid of the host user that owns ./data (cache + Jellyfin ledger). Defaults 1000:1000.
#PUID=1000
#PGID=1000

# Renderer tuning
#PAGES=2            # Chromium page pool (parallel renders)
#DEFAULT_SIZE=1000  # px, square
#MAX_SIZE=2000

# bin/backfill-jellyfin.mjs (only needed if you use the Jellyfin backfill)
#JELLYFIN_URL=http://jellyfin.local:8096
#JELLYFIN_API_KEY=...
#JELLYFIN_USER_ID=...          # optional; scopes the item listing to that user's libraries
#COVER_FORGE_URL=http://127.0.0.1:8793   # where the backfill fetches covers from (inside the container: itself)
#COVER_FORGE_TOKEN=            # defaults to TOKEN
#LEDGER=/data/ledger.json
