# cover-forge configuration — copy to .env (never commit .env)

# Optional bearer token. Unset = open (fine when only published on 127.0.0.1).
#TOKEN=change-me

# Host directory bind-mounted as /data (render cache + Jellyfin ledger). Defaults to ./data next to
# docker-compose.yml; point it at a backed-up location if you use the backfill (the ledger matters).
# (Do not set DATA_DIR here: that is the in-container path, fixed at /data.)
#HOST_DATA_DIR=./data

# uid:gid of the host user that owns the data dir. Defaults 1000:1000.
#PUID=1000
#PGID=1000

# Renderer tuning
#PAGES=2            # Chromium page pool (parallel renders)
#DEFAULT_SIZE=1000  # px, square
#MAX_SIZE=2000

# bin/backfill-jellyfin.mjs (only needed if you use the Jellyfin backfill)
#JELLYFIN_URL=http://jellyfin.local:8096
#JELLYFIN_API_KEY=...
#JELLYFIN_USER_ID=...          # optional; scopes the item listing to that user's libraries
#COVER_FORGE_URL=http://127.0.0.1:8793   # where the backfill fetches covers from (inside the container: itself)
#COVER_FORGE_TOKEN=            # defaults to TOKEN
#LEDGER=/data/ledger.json

# bin/backfill-folder.mjs (writes the same placeholders as folder.jpg into the album folders on disk)
#MUSIC_DIR=/path/to/music       # host side, bind-mounted read-write at /music (compose); default ./music (empty)
#MUSIC_ROOT=/music              # where that tree is inside the container
#JELLYFIN_MUSIC_PREFIX=/music   # the same tree as Jellyfin reports it in item paths (e.g. its own container mount)
#LEDGER_FOLDER=/data/ledger-folder.json
#JPEG_QUALITY=90                # renderer: quality for format=jpeg / *.jpg
